# Public build (Vercel). Only non-secret values belong here.
#
# VITE_READ_ONLY marks a build with no backend behind it: the app starts in
# Verify mode and the notarize flow shows a read-only notice. Set explicitly
# rather than inferred, so local development is never put in read-only by
# accident.
#
# The creator address is public by nature — it is an Ethereum address, and
# every query anchors on it via createdBy() so entities written by anyone else
# cannot appear.
VITE_READ_ONLY="true"

VITE_ARKIV_CREATOR_ADDRESS="0x8458cF7ED1f5CeA1fe2cD1aa34E67A53a88Bf38e"

# Empty = Tiramisu's default public RPC. Never put an access key here: a
# frontend value is readable by anyone who opens the page.
VITE_ARKIV_RPC_URL=""
