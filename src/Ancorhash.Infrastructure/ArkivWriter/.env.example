# Wallet del relayer che FIRMA le entità Arkiv.
# Va in un .env locale, gitignorato. MAI nel codice, mai in un commit.
# Serve test GLM dal faucet: https://hub.arkiv.network/faucet
ARKIV_PRIVATE_KEY=0xLA_TUA_CHIAVE_PRIVATA

# RPC Tiramisu. Vuoto = endpoint pubblico di default, fortemente rate-limited.
# Per alzare i limiti: access key da https://hub.arkiv.network/access-keys
# accodata all'URL. L'access key resta lato server, mai nel bundle frontend.
ARKIV_RPC_URL=
